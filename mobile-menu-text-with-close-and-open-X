/* Align the hamburger icon and MENU label - Divi 5 */
.et_pb_menu .mobile_menu_bar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

/* Add MENU text */
.et_pb_menu .mobile_menu_bar::after {
    content: "MENU";
    color: #ef6c00;
    font-family: inherit;
    font-size: 20px;
    line-height: 1;
}

/* Change hamburger to X when opened */
.et_pb_menu .mobile_nav.opened .mobile_menu_bar::before {
    content: "\4d";
}
