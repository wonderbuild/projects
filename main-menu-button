/* MENU ITEM BUTTON */
.menu_cta {border-radius: 0px;}
.menu_cta a {color: #fff!important;}

li.menu_cta {
	background-color:#2c002d; 
	font-weight: 700; 
	text-transform: uppercase; 
	text-align: center; 
	padding: 10px 10px 10px 10px !important;
	border-radius: 11px;
	-moz-transition: all 0.5s; 
	-webkit-transition: all 0.5s;
	transition: all 0.5s;
    margin: -5px 20px 10px 0px !important;
}
	
li.menu_cta:hover {
    background-color:#49004d !important;}
li.menu_cta a:hover {opacity: 1 !important;}


@media only screen and (min-width : 981px) {
            li.menu_cta {height: 33px;}}

.et_mobile_menu li.menu_cta {
  height:50px !important;
  margin-top: 20px !important;
}
.et_mobile_menu li.menu_cta a {
  padding: 5px !important;
}
